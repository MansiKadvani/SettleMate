@model SettleMate.Models.Student.ResetPasswordModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        SettleMate - Reset Password
    </title>


    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=Nunito:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://unpkg.com/lucide@latest"></script>


    <link rel="stylesheet"
          href="~/css/site.css">


    <link rel="stylesheet"
          href="~/css/student/forgot-password.css">

</head>


<body class="forgot-page">


    <div class="forgot-card">


        <!-- LOGO -->

        <div class="forgot-logo">

            <img src="~/images/Student/logo.png"
                 alt="SettleMate Logo">

            <p>
                Find your perfect space, effortlessly.
            </p>

        </div>


        <!-- ICON -->

        <div class="forgot-icon">

            <i data-lucide="lock"></i>

        </div>


        <h1>
            Reset Password
        </h1>


        <p class="forgot-description">

            Create a new password for your account.

        </p>


        <!-- ERROR -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-box">

                @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                {
                    <div>
                        @error.ErrorMessage
                    </div>
                }

            </div>
        }


        <!-- FORM -->

        <form asp-controller="ForgotPassword"
              asp-action="ChangePassword"
              method="post">


            <!-- NEW PASSWORD -->

            <label>
                New Password
            </label>


            <div class="forgot-input-wrapper">

                <i data-lucide="lock"></i>


                <input type="password"
                       asp-for="NewPassword"
                       placeholder="Enter new password">

            </div>


            <span class="validation-error"
                  asp-validation-for="NewPassword">
            </span>


            <!-- CONFIRM PASSWORD -->

            <label class="second-label">

                Confirm New Password

            </label>


            <div class="forgot-input-wrapper">

                <i data-lucide="lock-keyhole"></i>


                <input type="password"
                       asp-for="ConfirmPassword"
                       placeholder="Confirm new password">

            </div>


            <span class="validation-error"
                  asp-validation-for="ConfirmPassword">
            </span>


            <button type="submit"
                    class="forgot-button">

                Change Password

            </button>


        </form>


    </div>


    <script>

        lucide.createIcons();

    </script>

</body>

</html>