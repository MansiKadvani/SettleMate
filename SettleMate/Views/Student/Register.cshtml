@model SettleMate.Models.Student.RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>SettleMate - Registration</title>


    <!-- =====================================================
         FONTS
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=Nunito:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         TAILWIND
         ===================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =====================================================
         LUCIDE ICONS
         ===================================================== -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =====================================================
         GLOBAL DESIGN CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css" />


    <!-- =====================================================
         REGISTRATION CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/student/register.css" />

</head>


<body class="min-h-screen flex items-center justify-center md:p-2">


    <!-- =====================================================
         REGISTRATION CONTAINER
         ===================================================== -->

    <div class="registration-card flex flex-col md:flex-row w-full max-w-[1100px] overflow-hidden min-h-[700px]">


        <!-- =================================================
             LEFT SIDE
             ================================================= -->

        <div class="w-full md:w-[50%] md:p-5 p-8 flex flex-col justify-between">


            <div>


                <!-- =========================================
                     LOGO
                     ========================================= -->

                <div class="flex flex-col items-center mb-8">

                    <img src="~/images/Student/logo.png"
                         alt="SettleMate Logo"
                         class="h-34 w-32 object-contain">

                    <h3 class="text-sm font-semibold text-[#526777]">
                        Find your perfect space, effortlessly.
                    </h3>

                </div>


                <!-- =========================================
                     PROGRESS BAR
                     ========================================= -->

                <div class="registration-step-track relative flex justify-between items-center max-w-[300px] mx-auto mb-12">


                    <!-- STEP 1 -->

                    <div class="relative z-10 flex flex-col items-center">

                        <div id="pill-1"
                             class="step-pill active">

                            1

                        </div>

                        <span class="text-[10px] font-medium text-[#0D9488] mt-1">
                            Account
                        </span>

                    </div>


                    <!-- STEP 2 -->

                    <div class="relative z-10 flex flex-col items-center">

                        <div id="pill-2"
                             class="step-pill">

                            2

                        </div>

                        <span class="text-[10px] font-medium text-[#0D9488] mt-1">
                            Security
                        </span>

                    </div>


                    <!-- STEP 3 -->

                    <div class="relative z-10 flex flex-col items-center">

                        <div id="pill-3"
                             class="step-pill">

                            3

                        </div>

                        <span class="text-[10px] font-medium text-[#0D9488] mt-1">
                            Location
                        </span>

                    </div>


                    <!-- STEP 4 -->

                    <div class="relative z-10 flex flex-col items-center">

                        <div id="pill-4"
                             class="step-pill">

                            4

                        </div>

                        <span class="text-[10px] font-medium text-[#0D9488] mt-1">
                            Profile
                        </span>

                    </div>

                </div>


                <!-- =========================================
                     SUCCESS MESSAGE
                     ========================================= -->
                @if (TempData["Success"] != null)
                {
                    <div class="mb-6 text-center text-green-600 font-semibold">

                        @TempData["Success"]

                    </div>
                }


                <!-- =========================================
                     ERROR MESSAGE
                     ========================================= -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 text-red-500 text-sm">

                        @Html.ValidationSummary(
                        false,
                                        "",
                                        new { @class = "text-red-500" })

                </div>
                                }


                <!-- =========================================
                     RESEND MESSAGE
                     ========================================= -->
                @if (ViewBag.ResendMessage != null)
                {
                    <div class="mb-4 text-center text-green-600 text-sm font-semibold">

                        @ViewBag.ResendMessage

                    </div>
                }


                <!-- =========================================
                     REGISTRATION FORM
                     ========================================= -->

                <form id="regForm"
                      method="post"
                      action="/Student/Register/SendOTP">


                    <!-- =================================================
                         HIDDEN GENDER
                         ================================================= -->

                    <input type="hidden"
                           name="Gender"
                           id="genderInput"
                           value="@(Model?.Gender ?? "Other")">


                    <!-- =================================================
                         HIDDEN PROFILE PHOTO
                         ================================================= -->

                    <input type="hidden"
                           name="ProfilePhoto"
                           id="profilePhotoInput"
                           value="@(Model?.ProfilePhoto ?? "female_01.png")">


                    <!-- =================================================
                         STEP 1 - ACCOUNT
                         ================================================= -->

                    <div id="step-1"
                         class="step-content active">


                        <h2 class="text-xl font-bold mx-auto border-b-2 border-[#123B66] w-fit pb-1 mb-8">

                            Account Setup

                        </h2>


                        <div class="space-y-4">


                            <!-- FULL NAME -->

                            <div>

                                <label class="registration-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       name="Name"
                                       value="@Model?.Name"
                                       placeholder="John Doe"
                                       class="registration-input"
                                       maxlength="100"
                                       minlength="3"
                                       required>

                            </div>


                            <!-- GENDER -->

                            <div>

                                <label class="registration-label mb-2">
                                    Gender Preference
                                </label>


                                <div class="flex gap-3">


                                    <div class="gender-pill text-sm @(Model?.Gender == "Male" ? "selected" : "")"
                                         onclick="selectGender(this)">

                                        Male

                                    </div>


                                    <div class="gender-pill text-sm @(Model?.Gender == "Female" ? "selected" : "")"
                                         onclick="selectGender(this)">

                                        Female

                                    </div>


                                    <div class="gender-pill text-sm @(string.IsNullOrEmpty(Model?.Gender) || Model?.Gender == "Other" ? "selected" : "")"
                                         onclick="selectGender(this)">

                                        Other

                                    </div>

                                </div>

                            </div>


                            <!-- MOBILE -->

                            <div>

                                <label class="registration-label">
                                    Mobile Number
                                </label>


                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="phone"
                                           class="w-4 h-4">
                                        </i>

                                    </span>


                                    <input type="tel"
                                           name="Phone"
                                           value="@Model?.Phone"
                                           placeholder="1234567890"
                                           class="registration-input pl-10"
                                           maxlength="10"
                                           pattern="[0-9]{10}"
                                           required>

                                </div>

                            </div>


                            <!-- EMAIL -->

                            <div>

                                <label class="registration-label">
                                    Email Address
                                </label>


                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="mail"
                                           class="w-4 h-4">
                                        </i>

                                    </span>


                                    <input type="email"
                                           name="Email"
                                           value="@Model?.Email"
                                           placeholder="john@example.com"
                                           class="registration-input pl-10"
                                           maxlength="100"
                                           required>

                                </div>


                                <p class="text-xs text-[#526777] mt-1 ml-1">

                                    OTP will be sent to this email after you complete the registration form.

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         STEP 2 - SECURITY
                         ================================================= -->

                    <div id="step-2"
                         class="step-content">


                        <h2 class="text-xl font-bold mx-auto border-b-2 border-[#123B66] w-fit pb-1 mb-6">

                            Security

                        </h2>


                        <div class="space-y-4">


                            <!-- PASSWORD -->

                            <div>

                                <label class="registration-label">
                                    Create Password
                                </label>


                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="lock"
                                           class="w-4 h-4">
                                        </i>

                                    </span>


                                    <input type="password"
                                           name="Password"
                                           id="passwordInput"
                                           placeholder="••••••••"
                                           class="registration-input px-10"
                                           minlength="8"
                                           maxlength="50"
                                           required>


                                    <button type="button"
                                            onclick="togglePassword('passwordInput', this)"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="eye-off"
                                           class="w-4 h-4">
                                        </i>

                                    </button>

                                </div>


                                <p class="password-helper mt-1 ml-1">

                                    Must be at least 8 characters long.

                                </p>

                            </div>


                            <!-- CONFIRM PASSWORD -->

                            <div>

                                <label class="registration-label">
                                    Confirm Password
                                </label>


                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="refresh-cw"
                                           class="w-4 h-4">
                                        </i>

                                    </span>


                                    <input type="password"
                                           name="ConfirmPassword"
                                           id="confirmPasswordInput"
                                           placeholder="••••••••"
                                           class="registration-input px-10"
                                           minlength="8"
                                           maxlength="50"
                                           required>


                                    <button type="button"
                                            onclick="togglePassword('confirmPasswordInput', this)"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="eye-off"
                                           class="w-4 h-4">
                                        </i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         STEP 3 - LOCATION
                         ================================================= -->

                    <div id="step-3"
                         class="step-content">


                        <h2 class="text-xl font-bold mx-auto border-b-2 border-[#123B66] w-fit pb-1 mb-6">

                            Location Details

                        </h2>


                        <div class="space-y-6">


                            <!-- CITY -->

                            <div>

                                <label class="registration-label">
                                    City
                                </label>


                                <select name="City"
                                        class="registration-input appearance-none"
                                        required>

                                    <option value="">
                                        Select your city
                                    </option>

                                    <option value="Rajkot"
                                            selected="@(Model?.City == "Rajkot")">

                                        Rajkot

                                    </option>

                                    <option value="Ahmedabad"
                                            selected="@(Model?.City == "Ahmedabad")">

                                        Ahmedabad

                                    </option>

                                </select>

                            </div>


                            <!-- ADDRESS -->

                            <div>

                                <label class="registration-label">
                                    Preferred Location
                                </label>


                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#526777]">

                                        <i data-lucide="map-pin"
                                           class="w-4 h-4">
                                        </i>

                                    </span>


                                    <input type="text"
                                           name="Address"
                                           value="@Model?.Address"
                                           placeholder="Neighborhood or Zip"
                                           class="registration-input pl-10"
                                           maxlength="250"
                                           required>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         STEP 4 - AVATAR
                         ================================================= -->

                    <div id="step-4"
                         class="step-content">


                        <h2 class="text-xl font-bold mx-auto border-b-2 border-[#123B66] w-fit pb-1 mb-6">

                            Choose Your Avatar

                        </h2>


                        <!-- FEMALE AVATARS -->

                        <div class="flex justify-between items-center px-2 mb-8">


                            <div class="avatar-circle @(Model?.ProfilePhoto == "female_01.png" || string.IsNullOrEmpty(Model?.ProfilePhoto) ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/female_01.png"
                                     alt="Female Avatar 1">

                            </div>


                            <div class="avatar-circle @(Model?.ProfilePhoto == "female_02.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/female_02.png"
                                     alt="Female Avatar 2">

                            </div>


                            <div class="avatar-circle @(Model?.ProfilePhoto == "female_03.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/female_03.png"
                                     alt="Female Avatar 3">

                            </div>


                            <div class="avatar-circle @(Model?.ProfilePhoto == "female_04.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/female_04.png"
                                     alt="Female Avatar 4">

                            </div>

                        </div>


                        <!-- MALE AVATARS -->

                        <div class="flex justify-between items-center px-2 mb-8">


                            <div class="avatar-circle @(Model?.ProfilePhoto == "male_01.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/male_01.png"
                                     alt="Male Avatar 1">

                            </div>


                            <div class="avatar-circle @(Model?.ProfilePhoto == "male_02.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/male_02.png"
                                     alt="Male Avatar 2">

                            </div>


                            <div class="avatar-circle @(Model?.ProfilePhoto == "male_03.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/male_03.png"
                                     alt="Male Avatar 3">

                            </div>


                            <div class="avatar-circle @(Model?.ProfilePhoto == "male_04.png" ? "selected" : "")"
                                 onclick="selectAvatar(this)">

                                <img src="~/images/Student/male_04.png"
                                     alt="Male Avatar 4">

                            </div>

                        </div>

                    </div>


                </form>

            </div>


            <!-- =================================================
                 FOOTER BUTTONS
                 ================================================= -->

            <div class="flex gap-4 mt-12">


                <!-- BACK -->

                <button id="backBtn"
                        type="button"
                        onclick="prevStep()"
                        class="hidden flex-1 registration-back-btn py-3 font-semibold">

                    Back

                </button>


                <!-- NEXT -->

                <button id="nextBtn"
                        type="button"
                        onclick="nextStep()"
                        class="flex-[2] registration-primary-btn py-3 font-semibold flex items-center justify-center gap-2">

                    <span id="nextText">

                        Continue

                    </span>


                    <i data-lucide="arrow-right"
                       class="w-4 h-4"
                       id="nextIcon">

                    </i>

                </button>

            </div>

        </div>


        <!-- =================================================
             RIGHT SIDE - ILLUSTRATION
             ================================================= -->

        <div class="hidden md:flex md:w-[50%] bg-[#F1F5F9] relative items-center justify-center">

            <img src="~/images/illustration.png"
                 alt="SettleMate Illustration"
                 class="w-full h-full object-cover z-10">

        </div>

    </div>


    <!-- =====================================================
         EMAIL VERIFICATION MODAL
         ===================================================== -->

    <div id="verifyModal"
         class="verify-modal hidden">


        <div class="verify-modal-card">


            <!-- CLOSE -->

            <button type="button"
                    onclick="closeModal()"
                    class="absolute right-6 top-6 text-[#526777] hover:text-[#102A43]">

                <i data-lucide="x"
                   class="w-5 h-5">

                </i>

            </button>


            <!-- EMAIL ICON -->

            <div class="w-16 h-16 bg-[#CCFBF1] rounded-full flex items-center justify-center mx-auto mb-6">

                <i data-lucide="mail"
                   class="w-8 h-8 text-[#0D9488]">

                </i>

            </div>


            <h2 class="text-xl font-bold mb-2">

                Verify Email

            </h2>


            <p class="text-sm text-[#526777] mb-8">

                We sent a 6-digit code to

                <span class="font-medium text-[#102A43]">

                    @(ViewBag.OTPEmail ?? Model?.Email ?? "your email")

                </span>

            </p>


            <!-- =================================================
                 OTP INPUTS
                 ================================================= -->

            <div class="flex justify-between gap-2 mb-6">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp1"
                       oninput="moveOTP(this, 'otp2')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp2"
                       oninput="moveOTP(this, 'otp3')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp3"
                       oninput="moveOTP(this, 'otp4')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp4"
                       oninput="moveOTP(this, 'otp5')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp5"
                       oninput="moveOTP(this, 'otp6')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp6">

            </div>


            <!-- TIMER -->

            <p id="otpTimer"
               class="text-xs text-[#526777] mb-2">

                02:00 remaining

            </p>


            <!-- RESEND -->

            <button type="button"
                    onclick="resendOTP()"
                    class="text-sm font-semibold text-[#0D9488] mb-8 hover:underline">

                Resend Code

            </button>


            <!-- VERIFY -->

            <button type="button"
                    onclick="verifyOTP()"
                    class="w-full registration-primary-btn py-4 font-semibold">

                Verify Account

            </button>

        </div>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>


        // =====================================================
        // LUCIDE
        // =====================================================

        lucide.createIcons();


        // =====================================================
        // CURRENT STEP
        // =====================================================

        let currentStep = 1;


        // =====================================================
        // OTP TIMER
        // =====================================================

        let otpTime = 120;

        let otpTimerInterval = null;


        // =====================================================
        // UPDATE UI
        // =====================================================

        function updateUI() {

            document
                .querySelectorAll('.step-content')
                .forEach(step => {

                    step.classList.remove('active');

                });


            document
                .getElementById(`step-${currentStep}`)
                .classList.add('active');


            document
                .querySelectorAll('.step-pill')
                .forEach((pill, index) => {

                    const stepIndex = index + 1;


                    if (stepIndex < currentStep) {

                        pill.classList.add('completed');

                        pill.classList.remove('active');

                        pill.innerHTML =
                            '<i data-lucide="check" class="w-4 h-4"></i>';

                    }

                    else if (stepIndex === currentStep) {

                        pill.classList.add('active');

                        pill.classList.remove('completed');

                        pill.innerHTML = stepIndex;

                    }

                    else {

                        pill.classList.remove('active');

                        pill.classList.remove('completed');

                        pill.innerHTML = stepIndex;

                    }

                });


            lucide.createIcons();


            // Back button

            document
                .getElementById('backBtn')
                .classList
                .toggle(
                    'hidden',
                    currentStep === 1
                );


            // Next button

            const nextText =
                document.getElementById('nextText');

            const nextIcon =
                document.getElementById('nextIcon');


            if (currentStep === 4) {

                nextText.textContent =
                    "Complete Registration";


                nextIcon.setAttribute(
                    'data-lucide',
                    'check-circle'
                );

            }

            else {

                nextText.textContent =
                    "Continue";


                nextIcon.setAttribute(
                    'data-lucide',
                    'arrow-right'
                );

            }


            lucide.createIcons();

        }


        // =====================================================
        // FRONTEND VALIDATION FOR CURRENT STEP
        // =====================================================

        function validateCurrentStep() {

            const step =
                document.getElementById(
                    `step-${currentStep}`
                );


            const inputs =
                step.querySelectorAll(
                    'input, select'
                );


            for (let input of inputs) {

                if (!input.checkValidity()) {

                    input.reportValidity();

                    return false;

                }

            }


            // Password confirmation

            if (currentStep === 2) {

                const password =
                    document.getElementById(
                        "passwordInput"
                    ).value;


                const confirmPassword =
                    document.getElementById(
                        "confirmPasswordInput"
                    ).value;


                if (password !== confirmPassword) {

                    alert(
                        "Passwords do not match."
                    );

                    return false;

                }

            }


            return true;

        }


        // =====================================================
        // NEXT STEP
        // =====================================================

        function nextStep() {

            if (!validateCurrentStep()) {

                return;

            }


            if (currentStep < 4) {

                currentStep++;

                updateUI();

            }

            else {

                // Submit complete registration

                document
                    .getElementById("regForm")
                    .submit();

            }

        }


        // =====================================================
        // PREVIOUS STEP
        // =====================================================

        function prevStep() {

            if (currentStep > 1) {

                currentStep--;

                updateUI();

            }

        }


        // =====================================================
        // GENDER
        // =====================================================

        function selectGender(element) {

            document
                .querySelectorAll('.gender-pill')
                .forEach(pill => {

                    pill.classList.remove(
                        'selected'
                    );

                });


            element.classList.add(
                'selected'
            );


            document.getElementById(
                'genderInput'
            ).value =
                element.innerText.trim();

        }


        // =====================================================
        // AVATAR
        // =====================================================

        function selectAvatar(element) {

            document
                .querySelectorAll('.avatar-circle')
                .forEach(avatar => {

                    avatar.classList.remove(
                        'selected'
                    );

                });


            element.classList.add(
                'selected'
            );


            const image =
                element.querySelector('img');


            const imagePath =
                image.getAttribute('src');


            const fileName =
                imagePath.split('/').pop();


            document.getElementById(
                'profilePhotoInput'
            ).value = fileName;

        }


        // =====================================================
        // PASSWORD SHOW / HIDE
        // =====================================================

        function togglePassword(
            inputId,
            button
        ) {

            const input =
                document.getElementById(
                    inputId
                );


            if (input.type === "password") {

                input.type = "text";

            }

            else {

                input.type = "password";

            }

        }


        // =====================================================
        // OPEN OTP MODAL
        // =====================================================

        function openModal() {

            const modal =
                document.getElementById(
                    'verifyModal'
                );


            modal.classList.remove(
                'hidden'
            );


            modal.classList.add(
                'show'
            );


            startOTPTimer();


            document
                .getElementById('otp1')
                .focus();

        }


        // =====================================================
        // CLOSE OTP MODAL
        // =====================================================

        function closeModal() {

            const modal =
                document.getElementById(
                    'verifyModal'
                );


            modal.classList.remove(
                'show'
            );


            modal.classList.add(
                'hidden'
            );

        }


        // =====================================================
        // START OTP TIMER
        // =====================================================

        function startOTPTimer() {

            otpTime = 120;


            if (otpTimerInterval != null) {

                clearInterval(
                    otpTimerInterval
                );

            }


            otpTimerInterval =
                setInterval(function () {

                    let minutes =
                        Math.floor(
                            otpTime / 60
                        );


                    let seconds =
                        otpTime % 60;


                    document.getElementById(
                        "otpTimer"
                    ).innerText =
                        String(minutes)
                            .padStart(2, "0")
                        + ":"
                        + String(seconds)
                            .padStart(2, "0")
                        + " remaining";


                    otpTime--;


                    if (otpTime < 0) {

                        clearInterval(
                            otpTimerInterval
                        );


                        document.getElementById(
                            "otpTimer"
                        ).innerText =
                            "OTP expired";

                    }

                }, 1000);

        }


        // =====================================================
        // MOVE TO NEXT OTP BOX
        // =====================================================

        function moveOTP(
            current,
            nextId
        ) {

            current.value =
                current.value.replace(
                    /[^0-9]/g,
                    ''
                );


            if (current.value.length === 1) {

                document
                    .getElementById(nextId)
                    .focus();

            }

        }


        // =====================================================
        // GET OTP
        // =====================================================

        function getOTP() {

            let otp = "";


            otp +=
                document.getElementById(
                    "otp1"
                ).value;


            otp +=
                document.getElementById(
                    "otp2"
                ).value;


            otp +=
                document.getElementById(
                    "otp3"
                ).value;


            otp +=
                document.getElementById(
                    "otp4"
                ).value;


            otp +=
                document.getElementById(
                    "otp5"
                ).value;


            otp +=
                document.getElementById(
                    "otp6"
                ).value;


            return otp;

        }


        // =====================================================
        // VERIFY OTP
        // =====================================================

        function verifyOTP() {

            const otp =
                getOTP();


            if (otp.length !== 6) {

                alert(
                    "Please enter the 6-digit OTP."
                );

                return;

            }


            const form =
                document.createElement(
                    "form"
                );


            form.method = "POST";


            form.action =
                "/Student/Register/VerifyOTP";


            const input =
                document.createElement(
                    "input"
                );


            input.type = "hidden";


            input.name = "otp";


            input.value = otp;


            form.appendChild(input);


            document.body.appendChild(
                form
            );


            form.submit();

        }


        // =====================================================
        // RESEND OTP
        // =====================================================

        function resendOTP() {

            const form =
                document.createElement(
                    "form"
                );


            form.method = "POST";


            form.action =
                "/Student/Register/ResendOTP";


            document.body.appendChild(
                form
            );


            form.submit();

        }


        // =====================================================
        // SHOW OTP MODAL AFTER OTP IS SENT
        // =====================================================

        @if (ViewBag.ShowOTP == true)
        {
                <text>

                    window.addEventListener(
                        "load",
                        function () {

                            currentStep = 4;

                            updateUI();

                            openModal();

                        }
                    );

                </text>
        }


    </script>


</body>

</html>