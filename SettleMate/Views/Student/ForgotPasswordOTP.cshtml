@model SettleMate.Models.Student.ForgotPasswordOTPModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        SettleMate - Verify OTP
    </title>


    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=Nunito:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://unpkg.com/lucide@latest"></script>


    <link rel="stylesheet"
          href="~/css/site.css">


    <link rel="stylesheet"
          href="~/css/student/forgot-password.css">

</head>


<body class="forgot-page">


    <div class="forgot-card">


        <!-- LOGO -->

        <div class="forgot-logo">

            <img src="~/images/Student/logo.png"
                 alt="SettleMate Logo">

            <p>
                Find your perfect space, effortlessly.
            </p>

        </div>


        <!-- ICON -->

        <div class="forgot-icon">

            <i data-lucide="shield-check"></i>

        </div>


        <h1>
            Verify OTP
        </h1>


        <p class="forgot-description">

            We sent a 6-digit OTP to

            <strong>
                @ViewBag.Email
            </strong>

        </p>


        <!-- ERROR -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-box">

                @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                {
                    <div>
                        @error.ErrorMessage
                    </div>
                }

            </div>
        }


        @if (TempData["Success"] != null)
        {
            <div class="success-box">

                @TempData["Success"]

            </div>
        }


        <!-- OTP FORM -->

        <form asp-controller="ForgotPassword"
              asp-action="VerifyOTP"
              method="post">


            <label>
                Enter OTP
            </label>


            <input type="text"
                   asp-for="OTP"
                   class="otp-main-input"
                   placeholder="Enter 6-digit OTP"
                   maxlength="6"
                   inputmode="numeric">


            <span class="validation-error"
                  asp-validation-for="OTP">
            </span>


            <button type="submit"
                    class="forgot-button">

                Verify OTP

            </button>

        </form>


        <!-- RESEND -->

        <form asp-controller="ForgotPassword"
              asp-action="ResendOTP"
              method="post">

            <button type="submit"
                    class="resend-button">

                Resend OTP

            </button>

        </form>


        <!-- BACK -->

        <a href="/Student/ForgotPassword"
           class="back-login">

            ← Change Email

        </a>


    </div>


    <script>

        lucide.createIcons();

    </script>

</body>

</html>